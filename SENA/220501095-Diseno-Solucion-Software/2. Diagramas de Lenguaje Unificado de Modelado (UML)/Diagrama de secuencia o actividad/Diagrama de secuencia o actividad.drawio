        <mxCell id="1dBEBW8bO7hfyrOaMl9S-181" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;BalanceInUsd&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="110" x="590" y="3220" as="geometry" />
        </mxCell>
        <mxCell id="1dBEBW8bO7hfyrOaMl9S-182" edge="1" parent="1" style="endArrow=block;html=1;rounded=0;endFill=0;edgeStyle=orthogonalEdgeStyle;dashed=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="">
