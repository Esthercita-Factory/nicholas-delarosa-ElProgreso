        <mxCell id="4-1fdfmYP4fHA1ttIVB--131" parent="4-1fdfmYP4fHA1ttIVB--128" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" value="Un movimiento no tiene un identificador natural (dos consignaciones del mismo valor el mismo segundo son eventos distintos); se necesita una clave sustituta." vertex="1">
