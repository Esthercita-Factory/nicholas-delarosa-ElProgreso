        <mxCell id="4-1fdfmYP4fHA1ttIVB--133" parent="4-1fdfmYP4fHA1ttIVB--132" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" value="&lt;b&gt;movements.amount&lt;/b&gt;,&amp;nbsp;&lt;b&gt;movements.fee&lt;/b&gt;" vertex="1">
